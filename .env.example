# Backend
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QDRANT_PATH=./data/qdrant
COLLECTION_NAME=hansard_v1
LLM_PROVIDER=groq            # groq | gemini | openrouter | ollama
LLM_FALLBACK_PROVIDER=       # optional second provider if the first is rate-limited
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b            # free-tier model names change; check console.groq.com/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ALLOWED_ORIGINS=http://localhost:5173
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2   # or BAAI/bge-reranker-base (1 GB, slower, better)
RETRIEVE_CANDIDATES=40
RERANK_TOP_N=8

# Pipeline
DATA_DIR=./data
CONTACT_EMAIL=               # put in the downloader User-Agent so the House can reach you
REQUEST_DELAY_SECONDS=1.0
START_DATE=2019-09-01
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
MIN_CHUNK_CHARS=200
EMBED_BATCH_SIZE=32
EMBED_THREADS=6              # ONNX CPU threads; 4-6 was fastest on a 12-thread laptop
EMBED_SHARD_SIZE=4096        # checkpoint every N chunks

# Frontend (frontend/.env)
VITE_API_URL=http://localhost:8000
